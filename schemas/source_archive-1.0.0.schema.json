{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archmeshrubbing:schema:source-archive:1.0.0",
  "title": "ArchMeshRubbing Corresponding Source Archive Sidecar 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archive",
    "format",
    "manifest",
    "root_directory",
    "schema_version",
    "source",
    "source_commit",
    "source_date_epoch",
    "source_tree"
  ],
  "properties": {
    "archive": {"$ref": "#/$defs/archiveDescriptor"},
    "format": {"const": "org.archmeshrubbing.source-archive"},
    "manifest": {"$ref": "#/$defs/manifestDescriptor"},
    "root_directory": {"$ref": "#/$defs/rootDirectory"},
    "schema_version": {"const": "1.0.0"},
    "source": {"$ref": "#/$defs/sourceDescriptor"},
    "source_commit": {"$ref": "#/$defs/gitObject"},
    "source_date_epoch": {"$ref": "#/$defs/sourceDateEpoch"},
    "source_tree": {"$ref": "#/$defs/gitObject"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sourceDateEpoch": {
      "type": "integer",
      "minimum": 315532800,
      "maximum": 4354819199
    },
    "rootDirectory": {
      "type": "string",
      "pattern": "^ArchMeshRubbing-source-[0-9a-f]{12}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    },
    "sourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "sha256", "size"],
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      }
    },
    "archiveDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+\\.zip$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 335544320
        }
      }
    },
    "manifestDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^ArchMeshRubbing-source-[0-9a-f]{12}/SOURCE-MANIFEST\\.json$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_blob_oid", "mode", "path", "sha256", "size"],
      "properties": {
        "git_blob_oid": {"$ref": "#/$defs/gitObject"},
        "mode": {"enum": ["100644", "100755"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        }
      }
    },
    "licenseDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "path", "sha256"],
      "properties": {
        "expression": {"const": "GPL-2.0-only"},
        "path": {"const": "LICENSE"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "commitObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "payload", "sha256", "size"],
      "properties": {
        "encoding": {"const": "base64"},
        "payload": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1398104,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_object",
        "files",
        "format",
        "license",
        "repository",
        "root_directory",
        "schema_version",
        "source",
        "source_commit",
        "source_date_epoch",
        "source_tree"
      ],
      "properties": {
        "commit_object": {"$ref": "#/$defs/commitObject"},
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {"$ref": "#/$defs/sourceFile"}
        },
        "format": {"const": "org.archmeshrubbing.source-manifest"},
        "license": {"$ref": "#/$defs/licenseDescriptor"},
        "repository": {
          "const": "https://github.com/lzpxilfe/ArchMeshRubbing"
        },
        "root_directory": {"$ref": "#/$defs/rootDirectory"},
        "schema_version": {"const": "1.0.0"},
        "source": {"$ref": "#/$defs/sourceDescriptor"},
        "source_commit": {"$ref": "#/$defs/gitObject"},
        "source_date_epoch": {"$ref": "#/$defs/sourceDateEpoch"},
        "source_tree": {"$ref": "#/$defs/gitObject"}
      }
    }
  }
}
