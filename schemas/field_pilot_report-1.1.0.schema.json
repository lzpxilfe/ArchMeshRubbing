{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archmeshrubbing:schema:field-pilot-report:1.1.0",
  "title": "ArchMeshRubbing Field Pilot Report 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application",
    "authentication",
    "build",
    "created_at_utc",
    "format",
    "inputs",
    "machine",
    "opengl_driver",
    "outcome",
    "performance",
    "pilot_sha256",
    "project_verification",
    "release_claim",
    "review",
    "review_input_sha256",
    "review_normalized_sha256",
    "schema_version",
    "survey_verification"
  ],
  "properties": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "authentication": {
      "const": {
        "kind": "none",
        "signature_present": false
      }
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "created_at_utc": {
      "$ref": "#/$defs/timestamp"
    },
    "format": {
      "const": "archmeshrubbing_field_pilot_report"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "machine": {
      "$ref": "#/$defs/machine"
    },
    "opengl_driver": {
      "$ref": "#/$defs/opengl"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "performance": {
      "$ref": "#/$defs/performance"
    },
    "pilot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "project_verification": {
      "allOf": [
        {
          "$ref": "urn:archmeshrubbing:schema:offline-verification-report:1.0.0"
        },
        {
          "type": "object",
          "required": [
            "artifact_kind",
            "authority"
          ],
          "properties": {
            "artifact_kind": {
              "enum": [
                "project",
                "unknown"
              ]
            },
            "authority": {
              "const": "self_contained"
            }
          }
        }
      ]
    },
    "release_claim": {
      "const": "single_pilot_only_not_release_approval"
    },
    "review": {
      "$ref": "urn:archmeshrubbing:schema:field-pilot-review:1.0.0"
    },
    "review_input_sha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "review_normalized_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "survey_verification": {
      "allOf": [
        {
          "$ref": "urn:archmeshrubbing:schema:offline-verification-report:1.0.0"
        },
        {
          "type": "object",
          "required": [
            "artifact_kind",
            "authority"
          ],
          "properties": {
            "artifact_kind": {
              "enum": [
                "survey_export",
                "unknown"
              ]
            },
            "authority": {
              "const": "matched_project"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "commit",
        "dependency_lock_sha256",
        "manifest_present",
        "source_tree",
        "windows_wheel_lock_sha256"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64}|unknown)$"
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_present": {
          "type": "boolean"
        },
        "source_tree": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        },
        "windows_wheel_lock_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depth_bits",
        "qt_platform",
        "renderer",
        "software_renderer",
        "vendor",
        "version"
      ],
      "properties": {
        "depth_bits": {
          "type": "integer",
          "minimum": 24
        },
        "qt_platform": {
          "const": "windows"
        },
        "renderer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "software_renderer": {
          "type": "boolean"
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opengl_report_name",
        "project_name",
        "review_name",
        "survey_name"
      ],
      "properties": {
        "opengl_report_name": {
          "$ref": "#/$defs/nullableSafeName"
        },
        "project_name": {
          "$ref": "#/$defs/safeName"
        },
        "review_name": {
          "$ref": "#/$defs/nullableSafeName"
        },
        "survey_name": {
          "$ref": "#/$defs/safeName"
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen",
        "logical_cpu_count",
        "machine",
        "peak_working_set_bytes",
        "process_bits",
        "python_implementation",
        "python_version",
        "release",
        "system",
        "total_physical_memory_bytes",
        "windows_build_number",
        "windows_compatibility_layer",
        "windows_major_version",
        "windows_minor_version",
        "windows_native_machine",
        "windows_product_type"
      ],
      "properties": {
        "frozen": {
          "type": "boolean"
        },
        "logical_cpu_count": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "machine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "peak_working_set_bytes": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "process_bits": {
          "enum": [
            32,
            64
          ]
        },
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "total_physical_memory_bytes": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "python_implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "windows_build_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "windows_compatibility_layer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "windows_major_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "windows_minor_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "windows_native_machine": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "windows_product_type": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "nullableCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64}|unknown)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullablePositiveInteger": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSafeName": {
      "anyOf": [
        {
          "$ref": "#/$defs/safeName"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableTimestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "opengl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_count",
        "context",
        "error",
        "input_name",
        "runtime_lock_sha256",
        "sha256",
        "size_bytes",
        "source_commit",
        "source_tree",
        "status",
        "tested_at_utc",
        "windows_runtime"
      ],
      "properties": {
        "check_count": {
          "type": "integer",
          "minimum": 0
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/context"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "input_name": {
          "$ref": "#/$defs/nullableSafeName"
        },
        "runtime_lock_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "source_commit": {
          "$ref": "#/$defs/nullableCommit"
        },
        "source_tree": {
          "anyOf": [
            {
              "enum": [
                "clean",
                "dirty",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_provided"
          ]
        },
        "tested_at_utc": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "windows_runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/windowsRuntime"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "check_count": {
                "enum": [
                  87,
                  88
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "fail",
                  "not_provided"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "check_count": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_verification",
        "human_review",
        "opengl_driver",
        "pilot",
        "scope",
        "windows_runtime"
      ],
      "properties": {
        "artifact_verification": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "human_review": {
          "enum": [
            "pass",
            "fail",
            "incomplete"
          ]
        },
        "opengl_driver": {
          "enum": [
            "pass",
            "fail",
            "not_provided"
          ]
        },
        "pilot": {
          "enum": [
            "verified",
            "failed",
            "incomplete"
          ]
        },
        "scope": {
          "const": "single_artifact_single_machine"
        },
        "windows_runtime": {
          "enum": [
            "pass",
            "not_target"
          ]
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_verification_ms",
        "survey_verification_ms",
        "total_verification_ms"
      ],
      "properties": {
        "project_verification_ms": {
          "type": "integer",
          "minimum": 0
        },
        "survey_verification_ms": {
          "type": "integer",
          "minimum": 0
        },
        "total_verification_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "safeName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "windowsRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine",
        "process_bits",
        "python_implementation",
        "python_version",
        "release",
        "system",
        "windows_build_number",
        "windows_compatibility_layer",
        "windows_major_version",
        "windows_minor_version",
        "windows_native_machine",
        "windows_product_type"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "process_bits": {
          "enum": [32, 64]
        },
        "python_implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "windows_build_number": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "windows_compatibility_layer": {
          "anyOf": [
            {"type": "string", "minLength": 1, "maxLength": 32},
            {"type": "null"}
          ]
        },
        "windows_major_version": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "windows_minor_version": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "windows_native_machine": {
          "anyOf": [
            {"type": "string", "minLength": 1, "maxLength": 32},
            {"type": "null"}
          ]
        },
        "windows_product_type": {
          "anyOf": [
            {"enum": [1, 2, 3]},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
